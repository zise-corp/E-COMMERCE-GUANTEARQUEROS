# ─── Base de datos (Neon o Supabase) ──────────────────────────────────────────
# Postgres con SSL. Neon: ...?sslmode=require
DATABASE_URL="postgresql://usuario:password@host/guantearqueros?sslmode=require"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# La API secret NUNCA se expone al cliente: solo firma en /api/admin/upload-signature.
# ROTAR ESTA CLAVE ANTES DE PRODUCCIÓN (fue compartida en un chat).
CLOUDINARY_CLOUD_NAME="dvbtbadg1"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dvbtbadg1"

# ─── Sesión del admin ─────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# ─── YoPago ───────────────────────────────────────────────────────────────────
# YOPAGO_MODE: sandbox (simulador local, no llama a la pasarela) | live
YOPAGO_MODE="sandbox"
YOPAGO_API_URL=""
YOPAGO_API_KEY=""
YOPAGO_SECRET=""
YOPAGO_WEBHOOK_SECRET=""

# ─── Negocio ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://guantearquerosbolivia.com.bo"
NEXT_PUBLIC_SUPPORT_EMAIL="ventas@guantearquerosbolivia.com.bo"
