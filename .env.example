# Copia este archivo a .env.local y reemplaza los valores de ejemplo.
# No subas credenciales reales al repositorio.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_24_CARACTERES

NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/guantearqueros
IMAGEKIT_PUBLIC_KEY=REEMPLAZAR_CON_CLAVE_PUBLICA
IMAGEKIT_PRIVATE_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA

NEXT_PUBLIC_SITE_URL=https://ejemplo.com
APP_BASE_URL=https://ejemplo.com
NEXT_PUBLIC_SUPPORT_EMAIL=ventas@ejemplo.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=59100000000
NEXT_PUBLIC_DREI_WHATSAPP=59100000000
NEXT_PUBLIC_SUPPORT_URL=https://ejemplo.com

# Activa cobros reales solo después de configurar y probar YoPago.
YOPAGO_MODE=disabled
YOPAGO_COMPANY_CODE=REEMPLAZAR_CON_CODIGO_DE_COMERCIO
YOPAGO_CALLBACK_USERNAME=REEMPLAZAR_CON_USUARIO
YOPAGO_CALLBACK_PASSWORD=REEMPLAZAR_CON_CONTRASENA
